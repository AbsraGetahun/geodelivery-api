# PostgreSQL + PostGIS connection string
# Host port 5433 is mapped to the container's 5432 (see docker-compose.yml)
DATABASE_URL="postgresql://user:password@localhost:5433/geodelivery?schema=public"

# Redis connection string
# Host port 6380 is mapped to the container's 6379 (see docker-compose.yml)
REDIS_URL="redis://localhost:6380"

# HTTP server port
PORT=3000

# Node environment
NODE_ENV=development